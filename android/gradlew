#!/usr/bin/env sh
# Generated by Gradle Wrapper
# This script forwards command line arguments to the Gradle Wrapper JAR.
# It also sets up the environment for the wrapper.

# Resolve the location of the wrapper JAR.
APP_HOME="$(cd "$(dirname "$0")" && pwd)"
GRADLE_WRAPPER_JAR="$APP_HOME/gradle/wrapper/gradle-wrapper.jar"

# Execute the wrapper JAR.
exec java -jar "$GRADLE_WRAPPER_JAR" "$@"
